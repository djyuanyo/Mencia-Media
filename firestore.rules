rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /movies/{movieId} {
      allow read, write: if true;
    }
    match /users/{userId} {
      allow read, write: if true;
    }
    match /profiles/{profileId} {
      allow read, write: if true;
    }
    match /playback_progress/{progressId} {
      allow read, write: if true;
    }
    match /watchlist/{watchlistId} {
      allow read, write: if true;
    }
  }
}
