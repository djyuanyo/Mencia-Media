#!/bin/bash
DIR="$(cd "$(dirname "$0")" && pwd)"
HTML_PATH="$DIR/../Resources/app/index.html"

if [ ! -f "$HTML_PATH" ]; then
    HTML_PATH="$DIR/../Resources/index.html"
fi

# Remove quarantine attribute to avoid Gatekeeper silent blocks
xattr -d com.apple.quarantine "$DIR/../.." 2>/dev/null || true

# Try opening in dedicated app mode if Chrome, Brave or Edge is available
if [ -d "/Applications/Google Chrome.app" ]; then
    open -na "Google Chrome" --args --app="file://$HTML_PATH" --window-size=1280,820 2>/dev/null || open "$HTML_PATH"
elif [ -d "$HOME/Applications/Google Chrome.app" ]; then
    open -na "$HOME/Applications/Google Chrome.app" --args --app="file://$HTML_PATH" --window-size=1280,820 2>/dev/null || open "$HTML_PATH"
elif [ -d "/Applications/Brave Browser.app" ]; then
    open -na "Brave Browser" --args --app="file://$HTML_PATH" --window-size=1280,820 2>/dev/null || open "$HTML_PATH"
elif [ -d "/Applications/Microsoft Edge.app" ]; then
    open -na "Microsoft Edge" --args --app="file://$HTML_PATH" --window-size=1280,820 2>/dev/null || open "$HTML_PATH"
else
    # Fallback to default browser (Safari, Firefox, etc.)
    open "$HTML_PATH"
fi

exit 0
